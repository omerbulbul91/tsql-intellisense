    "menus": {
      "editor/context": [
        {
          "command": "tsql-intellisense.runQuery",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@1"
        },
        {
          "command": "tsql-intellisense.addSnippetFromSelection",
          "when": "editorLangId == sql && tsqlIntellisense.active && editorHasSelection",
          "group": "z_tsql@2"
        },
        {
          "command": "tsql-intellisense.openSnippetManager",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@3"
        },
        {
          "command": "tsql-intellisense.formatSql",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@4"
        },
        {
          "command": "tsql-intellisense.openStyleSettings",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@5"
        },
        {
          "command": "tsql-intellisense.openProjectFile",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@6"
        },
        {
          "command": "tsql-intellisense.selectInObjectExplorer",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@7"
        }
      ],
      "editor/title": [],
      "view/title": [
        {
          "command": "tsql-intellisense.addConnection",
          "when": "view == tsqlConnections",
          "group": "navigation"
        },
        {
          "command": "tsql-intellisense.RefreshConnections",
          "when": "view == tsqlConnections",
          "group": "navigation"
        },
        {
          "command": "tsql-intellisense.openConnectionSettings",
          "when": "view == tsqlConnections",
          "group": "navigation"
        },
        {
          "command": "tsql-intellisense.refreshQueryHistory",
          "when": "view == tsqlQueryHistory",
          "group": "navigation"
        },
        {
          "command": "tsql-intellisense.clearQueryHistory",
          "when": "view == tsqlQueryHistory",
          "group": "navigation"
        },
        {
          "command": "tsql-intellisense.openQueryHistorySettings",
          "when": "view == tsqlQueryHistory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tsql-intellisense.newQueryFromTree",
          "when": "viewItem =~ /^Connection/",
          "group": "inline@1"
        },
        {
          "command": "tsql-intellisense.treeConnect",
          "when": "viewItem == ConnectionDisconnected"
        },
        {
          "command": "tsql-intellisense.disconnect",
          "when": "viewItem == ConnectionConnected"
        },
        {
          "command": "tsql-intellisense.editConnection",
          "when": "viewItem =~ /^Connection/ || viewItem == Database"
        },
        {
          "command": "tsql-intellisense.deleteConnection",
          "when": "viewItem =~ /^Connection/"
        },
        {
          "command": "tsql-intellisense.openNativeSettings",
          "when": "viewItem =~ /^Connection/",
          "group": "9_info@1"
        },
        {
          "command": "tsql-intellisense.openExtensionPage",
          "when": "viewItem =~ /^Connection/",
          "group": "9_info@2"
        },
        {
          "command": "tsql-intellisense.openWalkthrough",
          "when": "viewItem =~ /^Connection/",
          "group": "9_info@3"
        },
        {
          "command": "tsql-intellisense.RefreshDatabases",
          "when": "viewItem == ServerFolderDatabases",
          "group": "inline@1"
        },
        {
          "command": "tsql-intellisense.FilterDatabases",
          "when": "viewItem == ServerFolderDatabases",
          "group": "inline@2"
        },
        {
          "command": "tsql-intellisense.NewDatabase",
          "when": "viewItem == ServerFolderDatabases",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.RefreshDatabase",
          "when": "viewItem == Database",
          "group": "inline@1"
        },
        {
          "command": "tsql-intellisense.NewSchema",
          "when": "viewItem == Database",
          "group": "inline@2"
        },
        {
          "command": "tsql-intellisense.newQueryFromTree",
          "when": "viewItem == Database || viewItem == Schema || viewItem == ConnectionConnected",
          "group": "inline"
        },
        {
          "command": "tsql-intellisense.newQueryFromTree",
          "when": "viewItem == Database || viewItem == Schema || viewItem =~ /^Connection/"
        },
        {
          "command": "tsql-intellisense.loadDatabaseSchema",
          "when": "viewItem == Database"
        },
        {
          "command": "tsql-intellisense.exportSchema",
          "when": "viewItem == Database",
          "group": "2_export@1"
        },
        {
          "command": "tsql-intellisense.backupDatabase",
          "when": "viewItem == Database",
          "group": "3_backup@1"
        },
        {
          "command": "tsql-intellisense.restoreDatabase",
          "when": "viewItem == Database",
          "group": "3_backup@2"
        },
        {
          "command": "tsql-intellisense.RefreshFolder",
          "when": "viewItem =~ /^SchemaFolder/ || viewItem =~ /^FuncFolder/",
          "group": "inline@1"
        },
        {
          "command": "tsql-intellisense.FilterFolder",
          "when": "viewItem =~ /^SchemaFolder/ || viewItem =~ /^FuncFolder/",
          "group": "inline@2"
        },
        {
          "command": "tsql-intellisense.NewTable",
          "when": "viewItem == SchemaFolderTables",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.NewView",
          "when": "viewItem == SchemaFolderViews",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.NewProcedure",
          "when": "viewItem == SchemaFolderProcedures",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.NewTrigger",
          "when": "viewItem == SchemaFolderTriggers",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.NewScalarFunction",
          "when": "viewItem == FuncFolderSC",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.NewTableValuedFunction",
          "when": "viewItem == FuncFolderTV",
          "group": "inline@3"
        },
        {
          "command": "tsql-intellisense.selectTop100",
          "when": "viewItem == Table || viewItem == View"
        },
        {
          "command": "tsql-intellisense.copyTableScript",
          "when": "viewItem == Table"
        },
        {
          "command": "tsql-intellisense.openTableScript",
          "when": "viewItem == Table || viewItem == View || viewItem == Function"
        },
        {
          "command": "tsql-intellisense.alterProc",
          "when": "viewItem == Procedure"
        },
        {
          "command": "tsql-intellisense.insertSpParams",
          "when": "viewItem == Procedure"
        },
        {
          "submenu": "tsql-intellisense.ScriptAs",
          "when": "viewItem == Table || viewItem == View || viewItem == Procedure || viewItem == Function || viewItem == Trigger",
          "group": "2_script"
        },
        {
          "command": "tsql-intellisense.openInExplorer",
          "when": "viewItem == ProjectFolder"
        },
        {
          "command": "tsql-intellisense.openProjectFile",
          "when": "viewItem == Table || viewItem == View || viewItem == Procedure || viewItem == Function"
        },
        {
          "command": "tsql-intellisense.deleteHistoryEntry",
          "when": "viewItem == historyEntry",
          "group": "inline"
        }
      ],
      "tsql-intellisense.ScriptAs": [
        {
          "command": "tsql-intellisense.Script.Create",
          "group": "1_create@1"
        },
        {
          "command": "tsql-intellisense.Script.Alter",
          "group": "1_create@2"
        },
        {
          "command": "tsql-intellisense.Script.CreateOrAlter",
          "when": "viewItem == View || viewItem == Procedure || viewItem == Function || viewItem == Trigger",
          "group": "1_create@3"
        },
        {
          "command": "tsql-intellisense.Script.Drop",
          "group": "2_drop@1"
        },
        {
          "command": "tsql-intellisense.Script.DropAndCreate",
          "group": "2_drop@2"
        },
        {
          "command": "tsql-intellisense.Script.Select",
          "when": "viewItem == Table || viewItem == View",
          "group": "3_dml@1"
        },
        {
          "command": "tsql-intellisense.Script.Insert",
          "when": "viewItem == Table || viewItem == View",
          "group": "3_dml@2"
        },
        {
          "command": "tsql-intellisense.Script.Update",
          "when": "viewItem == Table || viewItem == View",
          "group": "3_dml@3"
        },
        {
          "command": "tsql-intellisense.Script.Delete",
          "when": "viewItem == Table || viewItem == View",
          "group": "3_dml@4"
        },
        {
          "command": "tsql-intellisense.Script.Execute",
          "when": "viewItem == Procedure || viewItem == Function",
          "group": "4_exec@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tsql-intellisense.runQuery",
        "key": "f5",
        "when": "editorLangId == sql && !inDebugMode && tsqlIntellisense.active && editorFocus"
      },
      {
        "command": "tsql-intellisense.newSqlFile",
        "key": "ctrl+alt+s",
        "when": "tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.queryShortcut0",
        "key": "alt+f1",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut10",
        "key": "ctrl+f1",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut1",
        "key": "ctrl+1",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut2",
        "key": "ctrl+2",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut3",
        "key": "ctrl+3",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut4",
        "key": "ctrl+4",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut5",
        "key": "ctrl+5",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut6",
        "key": "ctrl+6",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut7",
        "key": "ctrl+7",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut8",
        "key": "ctrl+8",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut9",
        "key": "ctrl+9",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.refreshDocumentCache",
        "key": "ctrl+shift+d",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.toggleResultsPanel",
        "key": "ctrl+r",
        "when": "tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.selectInObjectExplorer",
        "key": "ctrl+f12",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.openProjectFile",
        "key": "ctrl+f11",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.formatSql",
        "key": "ctrl+k ctrl+y",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsql-explorer",
          "title": "%viewsContainer.tsqlExplorer%",
          "icon": "resources/database.svg"
        }
      ],
      "panel": [
        {
          "id": "tsql-results-panel",
          "title": "%viewsContainer.queryResults%",
          "icon": "$(database)"
        },
        {
          "id": "tsql-messages-panel",
          "title": "%viewsContainer.messages%",
          "icon": "$(output)"
        }
      ]
    },
    "views": {
      "tsql-explorer": [
        {
          "id": "tsqlConnections",
          "name": "%view.connections%"
        },
        {
          "id": "tsqlQueryHistory",
          "name": "%view.queryHistory%"
        }
      ],
      "tsql-results-panel": [
        {
          "id": "tsqlResults",
          "name": "%view.queryResults%",
          "type": "webview"
        }
      ],
      "tsql-messages-panel": [
        {
          "id": "tsqlMessages",
          "name": "%view.messages%",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tsqlConnections",
        "contents": "%view.connectionsWelcome%",
        "when": "tsqlConnections.isEmpty"
      },
      {
        "view": "tsqlQueryHistory",
        "contents": "%view.queryHistoryWelcome%"
      }
    ],
    "snippets": [],
    "walkthroughs": [
      {
        "id": "tsql-intellisense.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "addConnection",
            "title": "%walkthrough.addConnection.title%",
            "description": "%walkthrough.addConnection.description%",
            "media": {
              "markdown": "walkthroughs/addConnection.md"
            },
            "completionEvents": [
              "onCommand:tsql-intellisense.addConnection"
            ]
          },
          {
            "id": "objectExplorer",
            "title": "%walkthrough.objectExplorer.title%",
            "description": "%walkthrough.objectExplorer.description%",
            "media": {
              "markdown": "walkthroughs/objectExplorer.md"
            },
            "completionEvents": [
              "onView:tsqlConnections"
            ]
          },
          {
            "id": "intellisense",
            "title": "%walkthrough.intellisense.title%",
            "description": "%walkthrough.intellisense.description%",
            "media": {
              "markdown": "walkthroughs/intellisense.md"
            }
          },
          {
            "id": "runQuery",
            "title": "%walkthrough.runQuery.title%",
            "description": "%walkthrough.runQuery.description%",
            "media": {
              "markdown": "walkthroughs/runQuery.md"
            },
            "completionEvents": [
              "onCommand:tsql-intellisense.runQuery"
            ]
          },
          {
            "id": "formatSql",
            "title": "%walkthrough.formatSql.title%",
            "description": "%walkthrough.formatSql.description%",
            "media": {
              "markdown": "walkthroughs/formatSql.md"
            },
            "completionEvents": [
              "onCommand:tsql-intellisense.formatSql"
            ]
          },
          {
            "id": "goToDefinition",
            "title": "%walkthrough.goToDefinition.title%",
            "description": "%walkthrough.goToDefinition.description%",
            "media": {
              "markdown": "walkthroughs/goToDefinition.md"
            }
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%config.title%",
        "properties": {
          "tsql-intellisense.connections": {
            "type": "array",
            "default": [],
            "markdownDescription": "%config.connectionsMarkdown%",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "%config.connections.name%"
                },
                "server": {
                  "type": "string",
                  "description": "%config.connections.server%"
                },
                "database": {
                  "type": "string",
                  "description": "%config.connections.database%"
                },
                "user": {
                  "type": "string",
                  "description": "%config.connections.user%"
                },
                "password": {
                  "type": "string",
                  "description": "%config.connections.password%"
                },
                "port": {
                  "type": "number",
                  "default": 1433,
                  "description": "%config.connections.port%"
                },
                "trustServerCertificate": {
                  "type": "boolean",
                  "default": true
                },
                "projectPath": {
                  "type": "string",
                  "description": "%config.connections.projectPath%"
                },
                "databaseProjects": {
                  "type": "object",
                  "description": "%config.connections.databaseProjects%",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "server",
                "database"
              ]
            }
          },
          "tsql-intellisense.autoRefreshMinutes": {
            "type": "number",
            "default": 30,
            "description": "%config.autoRefreshMinutes%"
          },
          "tsql-intellisense.openOptionsPanel": {
            "type": "null",
            "markdownDescription": "%config.openOptionsPanel%"
          }
        }
      },
      {
        "title": "%config.group.suggestions%",
        "properties": {
          "tsql-intellisense.insertionKeys": {
            "type": "object",
            "default": {
              "space": true,
              "dot": false,
              "parentheses": false,
              "comma": false,
              "bracket": false,
              "semicolon": false
            },
            "description": "%config.insertionKeys%"
          },
          "tsql-intellisense.joinMatchingNames": {
            "type": "boolean",
            "default": true,
            "description": "%config.joinMatchingNames%"
          },
          "tsql-intellisense.joinSwapColumnOrder": {
            "type": "boolean",
            "default": false,
            "description": "%config.joinSwapColumnOrder%"
          },
          "tsql-intellisense.snippetFolder": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.snippetFolderMarkdown%"
          }
        }
      },
      {
        "title": "%config.group.insertedCode%",
        "properties": {
          "tsql-intellisense.qualifyWithOwner": {
            "type": "boolean",
            "default": true,
            "description": "%config.qualifyWithOwner%"
          },
          "tsql-intellisense.aliases.assignAliases": {
            "type": "boolean",
            "default": true,
            "description": "%config.assignAliases%"
          },
          "tsql-intellisense.aliases.includeAS": {
            "type": "boolean",
            "default": false,
            "description": "%config.includeAS%"
          },
          "tsql-intellisense.aliases.capitaliseAliases": {
            "type": "boolean",
            "default": false,
            "description": "%config.capitaliseAliases%"
          },
          "tsql-intellisense.aliases.prefixesToIgnore": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.prefixesToIgnore%"
          }
        }
      },
      {
        "title": "%config.group.format%",
        "properties": {
          "tsql-intellisense.styleFile": {
            "type": "string",
            "default": "",
            "description": "%config.styleFile%"
          },
          "tsql-intellisense.maxLineLength": {
            "type": "number",
            "default": 120,
            "description": "%config.maxLineLength%"
          },
          "tsql-intellisense.styleOverrides": {
            "type": "object",
            "default": null,
            "description": "%config.styleOverrides%"
          },
          "tsql-intellisense.whitespace.spacesOrTabs": {
            "type": "string",
            "enum": [
              "spaces",
              "tabs"
            ],
            "default": "spaces",
            "description": "%config.ws.spacesOrTabs%"
          },
          "tsql-intellisense.whitespace.numberOfSpacesInTabs": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 8,
            "description": "%config.ws.numberOfSpaces%"
          },
          "tsql-intellisense.whitespace.wrapLinesLongerThan": {
            "type": "number",
            "default": 120,
            "minimum": 0,
            "maximum": 500,
            "description": "%config.ws.wrapLines%"
          },
          "tsql-intellisense.whitespace.emptyLinesBetweenStatements": {
            "type": "number",
            "default": 1,
            "enum": [
              0,
              1,
              2
            ],
            "description": "%config.ws.emptyLinesBetween%"
          },
          "tsql-intellisense.whitespace.emptyLinesAfterBatchSeparator": {
            "type": "number",
            "default": 1,
            "enum": [
              0,
              1,
              2
            ],
            "description": "%config.ws.emptyLinesAfterBatch%"
          },
          "tsql-intellisense.whitespace.preserveExistingEmptyLinesBetweenStatements": {
            "type": "boolean",
            "default": false,
            "description": "%config.ws.preserveEmptyBetween%"
          },
          "tsql-intellisense.whitespace.preserveExistingEmptyLinesWithinStatements": {
            "type": "boolean",
            "default": false,
            "description": "%config.ws.preserveEmptyWithin%"
          },
          "tsql-intellisense.whitespace.alignGroupsOfSingleLineComments": {
            "type": "boolean",
            "default": true,
            "description": "%config.ws.alignSingleLineComments%"
          },
          "tsql-intellisense.whitespace.alignMultilineCommentsMatchingCommonPatterns": {
            "type": "boolean",
            "default": true,
            "description": "%config.ws.alignMultilineComments%"
          },
          "tsql-intellisense.controlFlow.placeBeginOnNewLine": {
            "type": "boolean",
            "default": false,
            "description": "%config.cf.placeBeginOnNewLine%"
          },
          "tsql-intellisense.controlFlow.indentBeginEndKeywords": {
            "type": "boolean",
            "default": false,
            "description": "%config.cf.indentBeginEnd%"
          },
          "tsql-intellisense.controlFlow.indentContentsOfStatements": {
            "type": "boolean",
            "default": true,
            "description": "%config.cf.indentContents%"
          },
          "tsql-intellisense.controlFlow.collapseShortStatements": {
            "type": "boolean",
            "default": false,
            "description": "%config.cf.collapseShort%"
          },
          "tsql-intellisense.controlFlow.collapseShortStatementsShorterThan": {
            "type": "number",
            "default": 78,
            "description": "%config.cf.collapseShortLen%"
          },
          "tsql-intellisense.variables.declareAlignDataTypesAndValues": {
            "type": "boolean",
            "default": false,
            "description": "%config.var.alignDataTypes%"
          },
          "tsql-intellisense.variables.declareAddSpaceBetweenTypeAndPrecision": {
            "type": "boolean",
            "default": false,
            "description": "%config.var.addSpaceBetween%"
          },
          "tsql-intellisense.variables.setPlaceAssignedValueOnNewLine": {
            "type": "boolean",
            "default": false,
            "description": "%config.var.setPlaceValueOnNewLine%"
          },
          "tsql-intellisense.variables.setPlaceEqualsSignOnNewLine": {
            "type": "boolean",
            "default": true,
            "description": "%config.var.setPlaceEqualsOnNewLine%"
          },
          "tsql-intellisense.dataDml.clauseAlignment": {
            "type": "string",
            "enum": [
              "toStatement",
              "toKeyword"
            ],
            "default": "toStatement",
            "description": "%config.dml.clauseAlignment%"
          },
          "tsql-intellisense.dataDml.collapseShortDmlStatements": {
            "type": "boolean",
            "default": true,
            "description": "%config.dml.collapseShort%"
          },
          "tsql-intellisense.dataDml.collapseShortDmlShorterThan": {
            "type": "number",
            "default": 120,
            "description": "%config.dml.collapseShortLen%"
          },
          "tsql-intellisense.schemaDdl.alignDataTypesAndConstraints": {
            "type": "boolean",
            "default": true,
            "description": "%config.ddl.alignDataTypes%"
          },
          "tsql-intellisense.schemaDdl.placeFirstProcedureParameterOnNewLine": {
            "type": "string",
            "enum": [
              "never",
              "always",
              "ifMultiple"
            ],
            "default": "always",
            "description": "%config.ddl.placeFirstParam%"
          },
          "tsql-intellisense.schemaDdl.collapseShortDdlStatements": {
            "type": "boolean",
            "default": true,
            "description": "%config.ddl.collapseShort%"
          },
          "tsql-intellisense.schemaDdl.collapseShortDdlShorterThan": {
            "type": "number",
            "default": 120,
            "description": "%config.ddl.collapseShortLen%"
          }
        }
      },
      {
        "title": "%config.group.queries%",
        "properties": {
          "tsql-intellisense.queryHistory.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%config.queryHistory.enabled%"
          },
          "tsql-intellisense.queryHistory.maxQuerySize": {
            "type": "number",
            "default": 1048576,
            "description": "%config.queryHistory.maxQuerySize%"
          },
          "tsql-intellisense.queryHistory.maxEntries": {
            "type": "number",
            "default": 100,
            "description": "%config.queryHistory.maxEntries%"
          },
          "tsql-intellisense.queryHistory.retentionDays": {
            "type": "number",
            "default": 7,
            "description": "%config.queryHistory.retentionDays%"
          },
          "tsql-intellisense.resultDisplayMode": {
            "type": "string",
            "enum": [
              "tabs",
              "stacked"
            ],
            "default": "stacked",
            "description": "%config.resultDisplayMode%"
          },
          "tsql-intellisense.gridLibrary": {
            "type": "string",
            "enum": [
              "tabulator",
              "ag-grid",
              "handsontable"
            ],
            "default": "tabulator",
            "description": "%config.gridLibrary%"
          },
          "tsql-intellisense.queryShortcuts": {
            "type": "array",
            "description": "%config.queryShortcuts%",
            "default": [
              {
                "key": "Alt+F1",
                "query": "EXEC sp_help '@WORD'"
              },
              {
                "key": "Ctrl+1",
                "query": "EXEC sp_who"
              },
              {
                "key": "Ctrl+2",
                "query": "EXEC sp_lock"
              },
              {
                "key": "Ctrl+3",
                "query": "SELECT TOP 100 * FROM @WORD"
              }
            ],
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "%config.queryShortcuts.key%"
                },
                "query": {
                  "type": "string",
                  "description": "%config.queryShortcuts.query%"
                }
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node && esbuild src/extension.web.ts --bundle --outfile=dist/extension.web.js --external:vscode --format=cjs --platform=browser",
    "build:web": "esbuild src/extension.web.ts --bundle --outfile=dist/extension.web.js --external:vscode --format=cjs --platform=browser",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "test": "npx ts-node test/contextDetection.test.ts && npx ts-node test/projectSync.test.ts && npx ts-node test/formatter.test.ts && npx ts-node test/statementRule.test.ts && npx ts-node test/rename.test.ts && npx ts-node test/packageMenus.test.ts && npx ts-node test/schemaExporter.test.ts",
    "package": "vsce package"
  },
  "dependencies": {
    "monaco-editor": "^0.55.1",
    "mssql": "^12.2.1",
    "tabulator-tables": "^6.4.0",
    "ag-grid-community": "^33.0.0",
    "handsontable": "^14.6.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.9",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0"
  }
}
