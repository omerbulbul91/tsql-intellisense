{
  "name": "tsql-intellisense",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.5.3",
  "publisher": "omerbulbul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omerbulbul91/tsql-intellisense"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "contributes": {
    "submenus": [
      {
        "id": "tsql-intellisense.ScriptAs",
        "label": "Script As"
      }
    ],
    "commands": [
