{
  "name": "tsql-intellisense",
  "displayName": "T-SQL IntelliSense (Beta)",
  "description": "⚠️ Beta — SQL Prompt-like IntelliSense for T-SQL in VS Code. Features may change.",
  "version": "0.4.1",
  "publisher": "omerbulbul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omerbulbul91/tsql-intellisense"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.web.js",
  "contributes": {
    "commands": [
      {
        "command": "tsql-intellisense.connect",
        "title": "T-SQL IntelliSense: Connect to Database"
      },
      {
        "command": "tsql-intellisense.disconnect",
        "title": "T-SQL IntelliSense: Disconnect"
      },
      {
        "command": "tsql-intellisense.refreshSchema",
        "title": "T-SQL IntelliSense: Refresh Schema Cache",
        "icon": "$(sync)"
      },
      {
        "command": "tsql-intellisense.refreshDocumentCache",
        "title": "T-SQL IntelliSense: Refresh Cache for This File",
        "icon": "$(sync)"
      },
      {
        "command": "tsql-intellisense.alterProc",
        "title": "T-SQL IntelliSense: ALTER Procedure (Fetch SP Code)"
      },
      {
        "command": "tsql-intellisense.runQuery",
        "title": "T-SQL IntelliSense: Run Query",
        "icon": "$(play)"
      },
      {
        "command": "tsql-intellisense.copyTableScript",
        "title": "T-SQL IntelliSense: Copy Table/View Script"
      },
      {
        "command": "tsql-intellisense.openTableScript",
        "title": "T-SQL IntelliSense: Open Table/View Script"
      },
      {
        "command": "tsql-intellisense.setProjectPath",
        "title": "T-SQL IntelliSense: Set Project Path"
      },
      {
        "command": "tsql-intellisense.queryShortcut0",
        "title": "T-SQL IntelliSense: Query Shortcut Alt+F1"
      },
      {
        "command": "tsql-intellisense.queryShortcut1",
        "title": "T-SQL IntelliSense: Query Shortcut Ctrl+1"
      },
      {
        "command": "tsql-intellisense.queryShortcut2",
        "title": "T-SQL IntelliSense: Query Shortcut Ctrl+2"
      },
      {
        "command": "tsql-intellisense.queryShortcut3",
        "title": "T-SQL IntelliSense: Query Shortcut Ctrl+3"
      },
      {
        "command": "tsql-intellisense.newSqlFile",
        "title": "T-SQL IntelliSense: New SQL File"
      },
      {
        "command": "tsql-intellisense.setSnippetFolder",
        "title": "T-SQL IntelliSense: Set Snippet Folder"
      },
      {
        "command": "tsql-intellisense.formatSql",
        "title": "T-SQL IntelliSense: Format SQL"
      },
      {
        "command": "tsql-intellisense.setStyleFile",
        "title": "T-SQL IntelliSense: Set Style File"
      },
      {
        "command": "tsql-intellisense.openStyleSettings",
        "title": "T-SQL IntelliSense: SQL Prompt Options"
      },
      { "command": "tsql-intellisense.addConnection", "title": "T-SQL IntelliSense: Add Connection", "icon": "$(add)" },
      { "command": "tsql-intellisense.editConnection", "title": "T-SQL IntelliSense: Edit Connection", "icon": "$(edit)" },
      { "command": "tsql-intellisense.deleteConnection", "title": "T-SQL IntelliSense: Delete Connection", "icon": "$(trash)" },
      { "command": "tsql-intellisense.treeConnect", "title": "T-SQL IntelliSense: Connect", "icon": "$(plug)" },
      { "command": "tsql-intellisense.selectTop100", "title": "SELECT TOP 100", "icon": "$(play)" },
      { "command": "tsql-intellisense.openInExplorer", "title": "Open in Explorer", "icon": "$(folder-opened)" },
      { "command": "tsql-intellisense.insertSpParams", "title": "T-SQL IntelliSense: EXEC with Params" },
      { "command": "tsql-intellisense.newQueryFromTree", "title": "New Query", "icon": "$(new-file)" },
      { "command": "tsql-intellisense.switchDatabase", "title": "Switch Database", "icon": "$(database)" },
      { "command": "tsql-intellisense.filterItems", "title": "Filter...", "icon": "$(filter)" },
      { "command": "tsql-intellisense.clearFilter", "title": "Clear Filter", "icon": "$(filter-filled)" },
      { "command": "tsql-intellisense.loadDatabaseSchema", "title": "Refresh DB Schema", "icon": "$(sync)" },
      { "command": "tsql-intellisense.toggleResultsPanel", "title": "T-SQL IntelliSense: Toggle Query Results Panel" },
      { "command": "tsql-intellisense.selectInObjectExplorer", "title": "Select in Object Explorer" },
      { "command": "tsql-intellisense.openProjectFile", "title": "Open Project File", "icon": "$(go-to-file)" }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tsql-intellisense.formatSql",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "1_modification@1"
        },
        {
          "command": "tsql-intellisense.selectInObjectExplorer",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "z_tsql@1"
        }
      ],
      "editor/title": [
        {
          "command": "tsql-intellisense.runQuery",
          "when": "editorLangId == sql && tsqlIntellisense.active",
          "group": "navigation"
        }
      ],
      "view/title": [
        { "command": "tsql-intellisense.addConnection", "when": "view == tsqlConnections", "group": "navigation" },
        { "command": "tsql-intellisense.refreshSchema", "when": "view == tsqlConnections", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "tsql-intellisense.treeConnect", "when": "viewItem == connection.disconnected", "group": "1_connection" },
        { "command": "tsql-intellisense.newQueryFromTree", "when": "viewItem == connection.connected", "group": "1_connection" },
        { "command": "tsql-intellisense.disconnect", "when": "viewItem == connection.connected", "group": "1_connection" },
        { "command": "tsql-intellisense.refreshSchema", "when": "viewItem == connection.connected", "group": "1_connection" },
        { "command": "tsql-intellisense.editConnection", "when": "viewItem =~ /^connection\\./" , "group": "2_manage" },
        { "command": "tsql-intellisense.deleteConnection", "when": "viewItem =~ /^connection\\./" , "group": "2_manage" },
        { "command": "tsql-intellisense.setProjectPath", "when": "viewItem == connection.connected", "group": "2_manage" },
        { "command": "tsql-intellisense.newQueryFromTree", "when": "viewItem == database.connected", "group": "1_db" },
        { "command": "tsql-intellisense.switchDatabase", "when": "viewItem == database", "group": "1_db" },
        { "command": "tsql-intellisense.editConnection", "when": "viewItem =~ /^database/", "group": "2_manage" },
        { "command": "tsql-intellisense.filterItems", "when": "viewItem =~ /^folder\\./" , "group": "0_filter" },
        { "command": "tsql-intellisense.clearFilter", "when": "viewItem =~ /^folder\\./" , "group": "0_filter" },
        { "command": "tsql-intellisense.refreshSchema", "when": "viewItem =~ /^folder\\./" , "group": "1_actions" },
        { "command": "tsql-intellisense.selectTop100", "when": "viewItem == table", "group": "1_actions" },
        { "command": "tsql-intellisense.copyTableScript", "when": "viewItem == table", "group": "1_actions" },
        { "command": "tsql-intellisense.openTableScript", "when": "viewItem == table || viewItem == view || viewItem == func", "group": "1_actions" },
        { "command": "tsql-intellisense.alterProc", "when": "viewItem == sp", "group": "1_actions" },
        { "command": "tsql-intellisense.insertSpParams", "when": "viewItem == sp", "group": "1_actions" },
        { "command": "tsql-intellisense.openInExplorer", "when": "viewItem == projectFolder", "group": "1_actions" },
        { "command": "tsql-intellisense.newQueryFromTree", "when": "viewItem == connection.connected", "group": "inline" },
        { "command": "tsql-intellisense.editConnection", "when": "viewItem =~ /^connection\\./", "group": "inline" },
        { "command": "tsql-intellisense.refreshSchema", "when": "viewItem == connection.connected", "group": "inline" },
        { "command": "tsql-intellisense.deleteConnection", "when": "viewItem =~ /^connection\\./", "group": "inline" },
        { "command": "tsql-intellisense.newQueryFromTree", "when": "viewItem == database.connected", "group": "inline" },
        { "command": "tsql-intellisense.loadDatabaseSchema", "when": "viewItem == database.connected", "group": "inline" },
        { "command": "tsql-intellisense.newQueryFromTree", "when": "viewItem == database", "group": "inline" },
        { "command": "tsql-intellisense.loadDatabaseSchema", "when": "viewItem == database", "group": "inline" },
        { "command": "tsql-intellisense.filterItems", "when": "viewItem =~ /^folder\\./", "group": "inline" },
        { "command": "tsql-intellisense.refreshSchema", "when": "viewItem =~ /^folder\\./", "group": "inline" },
        { "command": "tsql-intellisense.openProjectFile", "when": "viewItem == table || viewItem == view || viewItem == sp || viewItem == func", "group": "inline" },
        { "command": "tsql-intellisense.openProjectFile", "when": "viewItem == table || viewItem == view || viewItem == sp || viewItem == func", "group": "navigation" }
      ]
    },
    "keybindings": [
      {
        "command": "tsql-intellisense.runQuery",
        "key": "f5",
        "when": "editorLangId == sql && !inDebugMode && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.newSqlFile",
        "key": "ctrl+alt+s",
        "when": "tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.queryShortcut0",
        "key": "alt+f1",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut1",
        "key": "ctrl+1",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut2",
        "key": "ctrl+2",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.queryShortcut3",
        "key": "ctrl+3",
        "when": "editorLangId == sql"
      },
      {
        "command": "tsql-intellisense.refreshDocumentCache",
        "key": "ctrl+shift+d",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.toggleResultsPanel",
        "key": "ctrl+r",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.selectInObjectExplorer",
        "key": "ctrl+f12",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.openProjectFile",
        "key": "ctrl+f11",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      },
      {
        "command": "tsql-intellisense.formatSql",
        "key": "ctrl+k ctrl+y",
        "when": "editorLangId == sql && tsqlIntellisense.active"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsql-explorer",
          "title": "T-SQL Explorer",
          "icon": "resources/database.svg"
        }
      ],
      "panel": [
        {
          "id": "tsql-results-panel",
          "title": "Query Results",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "tsql-explorer": [
        {
          "id": "tsqlConnections",
          "name": "Connections"
        }
      ],
      "tsql-results-panel": [
        {
          "id": "tsqlResults",
          "name": "Query Results",
          "type": "webview"
        }
      ]
    },
    "snippets": [
      {
        "language": "sql",
        "path": "./snippets/sql.json"
      }
    ],
    "configuration": {
      "title": "T-SQL IntelliSense",
      "properties": {
        "tsql-intellisense.connections": {
          "type": "array",
          "default": [],
          "description": "Saved database connections",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Connection profile name"
              },
              "server": {
                "type": "string",
                "description": "SQL Server hostname or IP"
              },
              "database": {
                "type": "string",
                "description": "Database name"
              },
              "user": {
                "type": "string",
                "description": "SQL login username"
              },
              "password": {
                "type": "string",
                "description": "SQL login password"
              },
              "port": {
                "type": "number",
                "default": 1433,
                "description": "SQL Server port"
              },
              "trustServerCertificate": {
                "type": "boolean",
                "default": true
              },
              "projectPath": {
                "type": "string",
                "description": "SQL Server Database Project directory path for automatic file sync on DDL execution"
              },
              "databaseProjects": {
                "type": "object",
                "description": "Per-database project paths: { \"DbName\": \"c:\\\\path\\\\to\\\\project\" }",
                "additionalProperties": { "type": "string" }
              }
            },
            "required": [
              "name",
              "server",
              "database"
            ]
          }
        },
        "tsql-intellisense.autoRefreshMinutes": {
          "type": "number",
          "default": 30,
          "description": "Auto-refresh schema cache interval in minutes (0 to disable)"
        },
        "tsql-intellisense.resultDisplayMode": {
          "type": "string",
          "enum": ["tabs", "stacked"],
          "default": "stacked",
          "description": "How to display multiple result sets: 'tabs' (switch between tabs) or 'stacked' (all visible, vertically)"
        },
        "tsql-intellisense.queryShortcuts": {
          "type": "array",
          "description": "SSMS-style query shortcuts. Use @WORD as placeholder for the word under cursor.",
          "default": [
            { "key": "Alt+F1", "query": "EXEC sp_help '@WORD'" },
            { "key": "Ctrl+1", "query": "EXEC sp_who" },
            { "key": "Ctrl+2", "query": "EXEC sp_lock" },
            { "key": "Ctrl+3", "query": "SELECT TOP 100 * FROM @WORD" }
          ],
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "Shortcut key label (for display only)"
              },
              "query": {
                "type": "string",
                "description": "SQL query to execute. @WORD = word under cursor"
              }
            }
          }
        },
        "tsql-intellisense.snippetFolder": {
          "type": "string",
          "default": "",
          "description": "Redgate SQL Prompt snippet JSON dosyalarını içeren dizin yolu"
        },
        "tsql-intellisense.aliases.assignAliases": {
          "type": "boolean",
          "default": true,
          "description": "Tablo/view seçildiğinde otomatik alias ata"
        },
        "tsql-intellisense.aliases.includeAS": {
          "type": "boolean",
          "default": false,
          "description": "Alias tanımında AS kullan (FROM Table AS t)"
        },
        "tsql-intellisense.aliases.capitaliseAliases": {
          "type": "boolean",
          "default": false,
          "description": "Alias'ları büyük harfle oluştur (SA yerine sa)"
        },
        "tsql-intellisense.aliases.prefixesToIgnore": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Alias üretirken yok sayılacak tablo adı prefix'leri (ör. Cv_Rn, Tb_Rn)"
        },
        "tsql-intellisense.maxLineLength": {
          "type": "number",
          "default": 120,
          "description": "SQL formatlama için maksimum satır uzunluğu (0 = wrap yok)"
        },
        "tsql-intellisense.styleFile": {
          "type": "string",
          "default": "",
          "description": "Redgate SQL Prompt stil dosyası (.json) yolu"
        },
        "tsql-intellisense.styleOverrides": {
          "type": "object",
          "default": null,
          "description": "Manuel casing ayarları (Formatting Styles panelinden kaydedilir)"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node && esbuild src/extension.web.ts --bundle --outfile=dist/extension.web.js --external:vscode --format=cjs --platform=browser",
    "build:web": "esbuild src/extension.web.ts --bundle --outfile=dist/extension.web.js --external:vscode --format=cjs --platform=browser",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "test": "npx ts-node test/contextDetection.test.ts && npx ts-node test/projectSync.test.ts && npx ts-node test/formatter.test.ts",
    "package": "vsce package"
  },
  "dependencies": {
    "tedious": "^18.6.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.24.0"
  }
}
